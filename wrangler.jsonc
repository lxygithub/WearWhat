// Cloudflare Workers 部署配置（配合 @opennextjs/cloudflare 使用）
// 参考：https://opennext.js/cloudflare
{
  // Worker 名称：部署后的默认访问地址为 https://wearwhat.<你的子域>.workers.dev
  "name": "wearwhat",

  // 入口文件：opennextjs-cloudflare build 会把 Next.js 应用打包成这个 Worker 脚本
  "main": ".open-next/worker.js",

  // 兼容日期：决定 Worker 运行时启用哪些行为（@opennextjs/cloudflare 官方推荐值）
  "compatibility_date": "2024-09-23",

  // 兼容标志：
  // - nodejs_compat：允许 Worker 使用 Node.js API 子集（Next.js 运行时依赖）
  // - global_fetch_strictly_public：让全局 fetch 只走公网出口，不会命中同 Zone 内部路由
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  // 静态资产：Next.js 的静态文件（.open-next/assets）由 Workers Assets 直接托管，
  // 绑定名为 ASSETS，Worker 内部可通过 env.ASSETS 读取
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Smart Placement：数据层在内网 PostgreSQL（经 SQL Gateway），让 Worker 尽量靠近
  // 数据源执行，减少「边缘 → 隧道 → 家机」往返（单程约 2.5s）。没有配置
  // run_worker_first，静态资源仍由边缘直接返回，不受影响。
  "placement": {
    "mode": "smart"
  },

  // D1 数据库绑定：数据库为 SQLite 方言，与本地 prisma/schema.prisma 兼容。
  // database_id 需要先执行 `bunx wrangler d1 create wearwhat-db`，
  // 然后把输出中的 database_id 粘贴替换进来（见 DEPLOY.md）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wearwhat-db",
      "database_id": "d5215dfd-0972-4152-97c0-94c861b48e9a"
    }
  ],

  // R2 对象存储：存衣物照片。
  // 库里只保留 /api/images/<uuid>.<ext> 这样的相对地址，图片本体在这里，
  // 由 src/app/api/images/[...key]/route.ts 读出来回给浏览器。
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "wearwhat-images"
    }
  ],

  // 可观测性：开启后在 Cloudflare 控制台可查看 Worker 的日志与指标
  // ── SQL Gateway（内网数据库统一查询入口）────────────────────────
  // 2026-09：数据层由 D1 迁到自建 PostgreSQL，Worker 经 WAF + Tunnel 调用家中网关，
  // 不直连数据库端口。地址与 target 名均非机密。协议与排错见 sql-gateway 仓库
  // 《使用与接入指南》；daohang / forgotit 用同一 target、各自独立 schema。
  "vars": {
    "SQL_GATEWAY_URL": "https://db-gateway.ieop.top/v1/query",
    // 独立库 + 独立 ro/rw 账号（库级隔离；原先用 forgotit 库的 wearwhat schema）
    "SQL_GATEWAY_TARGET": "wearwhat-postgres"
  },

  "observability": {
    "enabled": true
  }
}
